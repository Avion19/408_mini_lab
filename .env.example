# Copy this file to .env and replace the placeholder with your Canvas token.
# Never commit .env or share the token.
CANVAS_API_TOKEN=your_canvas_token_here

# Boise State Canvas instance. Keep the URL HTTPS when changing it.
CANVAS_BASE_URL=https://boisestatecanvas.instructure.com

# Optional: local Echo server port. Defaults to 8080.
PORT=8080
